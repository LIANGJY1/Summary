{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch main",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/C++/cpp_practice_project/main",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/C++/cpp_practice_project",
            "environment": [],
            "externalConsole": false,
            "preLaunchTask": "build main",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
